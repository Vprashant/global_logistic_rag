# Environment Configuration Example
# Copy this file to .env and fill in your values

# Application
APP_NAME=GlobalLogisticsRAG
APP_VERSION=1.0.0
ENVIRONMENT=development  # development, staging, production
DEBUG=true
LOG_LEVEL=INFO

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# LLM Providers
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_MODEL=gpt-4-turbo-preview
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Embedding Models
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
USE_LOCAL_EMBEDDINGS=false
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# Vector Database (choose one)
VECTOR_DB_TYPE=pinecone  # Options: pinecone, milvus, weaviate, chromadb

# Pinecone
PINECONE_API_KEY=your-pinecone-key
PINECONE_ENVIRONMENT=us-west1-gcp
PINECONE_INDEX_NAME=logistics-rag

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=logistics_documents

# Weaviate
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=your-weaviate-key
WEAVIATE_CLASS=LogisticsDocument

# PostgreSQL (for metadata and lineage)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=logistics_metadata
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password

# Redis (for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your-redis-password
CACHE_TTL=3600  # seconds

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_CONTRACTS=logistics-contracts
S3_BUCKET_DOCUMENTS=logistics-documents

# SharePoint
SHAREPOINT_CLIENT_ID=your-sharepoint-client-id
SHAREPOINT_CLIENT_SECRET=your-sharepoint-secret
SHAREPOINT_TENANT_ID=your-tenant-id
SHAREPOINT_SITE_URL=https://yourorg.sharepoint.com

# Database Connections (SAP/Oracle)
SAP_CONNECTION_STRING=hana://user:pass@host:port
ORACLE_CONNECTION_STRING=oracle+cx_oracle://user:pass@host:port/service
POSTGRES_SHIPMENTS_CONNECTION=postgresql://user:pass@host:port/shipments

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=logistics-rag-consumer
KAFKA_TOPIC_IOT=iot-sensors
KAFKA_TOPIC_EVENTS=logistics-events

# External APIs
PORT_API_URL=https://api.portcongestion.com
PORT_API_KEY=your-port-api-key
WEATHER_API_URL=https://api.weather.com
WEATHER_API_KEY=your-weather-api-key
SHIPPING_RATES_API_URL=https://api.shippingrates.com
SHIPPING_RATES_API_KEY=your-rates-api-key

# Security
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
ENCRYPTION_KEY=your-32-byte-encryption-key-base64

# PII Masking
ENABLE_PII_MASKING=true
PII_ENTITIES=PERSON,PHONE_NUMBER,EMAIL_ADDRESS,CREDIT_CARD,IBAN_CODE
MASK_CHAR=*

# RBAC
ENABLE_RBAC=true
DEFAULT_ROLE=viewer
ADMIN_EMAIL=admin@logistics.com

# Data Lineage
ENABLE_LINEAGE_TRACKING=true
LINEAGE_DB_CONNECTION=postgresql://user:pass@host:port/lineage

# Chunking Configuration
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200
CHUNKING_STRATEGY=recursive  # recursive, semantic, parent_child, context_aware

# Retrieval Configuration
RETRIEVAL_TOP_K=5
RETRIEVAL_METHOD=hybrid  # hybrid, semantic, bm25
SEMANTIC_WEIGHT=0.7
BM25_WEIGHT=0.3
ENABLE_RERANKING=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Caching
ENABLE_QUERY_CACHE=true
CACHE_HIT_THRESHOLD=0.95  # Similarity threshold for cache hits

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Monitoring
ENABLE_PROMETHEUS=true
PROMETHEUS_PORT=9090
ENABLE_OPENTELEMETRY=true
OTEL_EXPORTER_ENDPOINT=http://localhost:4318

# Celery (Background Tasks)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Document Processing
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,xlsx,xls,docx,txt,jpg,png
PDF_PARSER_LIBRARY=pdfplumber  # pdfplumber, pypdf, pdfminer
EXTRACT_TABLES=true
EXTRACT_IMAGES=true

# Batch Processing
BATCH_SIZE=10
MAX_CONCURRENT_INGESTIONS=5

# Testing
TEST_MODE=false
MOCK_EMBEDDINGS=false
MOCK_LLM_RESPONSES=false
